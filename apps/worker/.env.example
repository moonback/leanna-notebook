SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
WORKER_ID=
# Embeddings : openrouter (par défaut) | voyage | mistral — le modèle doit produire 1024 dimensions
EMBEDDINGS_PROVIDER=openrouter
EMBEDDINGS_MODEL=
EMBEDDINGS_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_CHAT_MODEL=
# Fast Research (B17) : clé Tavily requise côté web ET worker
TAVILY_API_KEY=

# Transcription audio (B06) : Deepgram Nova-3, segments horodatés
DEEPGRAM_API_KEY=
STT_MODEL=nova-3
STT_LANGUAGE=multi

# Audio Overview (G01) : deux voix ElevenLabs + assemblage ffmpeg
ELEVENLABS_API_KEY=
AUDIO_OVERVIEW_TTS_MODEL=eleven_multilingual_v2
AUDIO_OVERVIEW_HOST_VOICE_ID=
AUDIO_OVERVIEW_GUEST_VOICE_ID=
# Chemin du binaire ffmpeg (par défaut : ffmpeg dans le PATH)
FFMPEG_PATH=ffmpeg
