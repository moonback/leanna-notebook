SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
WORKER_ID=
# Embeddings : openrouter (par défaut) | voyage | mistral — le modèle doit produire 1024 dimensions
EMBEDDINGS_PROVIDER=openrouter
EMBEDDINGS_MODEL=
EMBEDDINGS_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_CHAT_MODEL=
# Fast Research (B17) : clé Tavily requise côté web ET worker
TAVILY_API_KEY=

# Transcription audio (B06) : Deepgram Nova-3, segments horodatés
DEEPGRAM_API_KEY=
STT_MODEL=nova-3
STT_LANGUAGE=multi

# Audio Overview (G01) : deux voix ElevenLabs + assemblage ffmpeg
ELEVENLABS_API_KEY=
AUDIO_OVERVIEW_TTS_MODEL=eleven_multilingual_v2
AUDIO_OVERVIEW_HOST_VOICE_ID=
AUDIO_OVERVIEW_GUEST_VOICE_ID=
# Chemin du binaire ffmpeg (par défaut : ffmpeg dans le PATH)
FFMPEG_PATH=ffmpeg

# Deep Research : TAVILY_API_KEY (ci-dessus) et OPENROUTER_API_KEY sont requises sur le worker.
# Plafond de coût facultatif par recherche (coût renvoyé par OpenRouter, en USD) ; vide = pas de plafond
DEEP_RESEARCH_MAX_COST_USD=
# Délai maximal d'un appel LLM OpenRouter, en ms (180000 par défaut)
OPENROUTER_TIMEOUT_MS=

# Import de dépôts GitHub publics : jeton optionnel (lecture seule, aucun scope requis)
# pour dépasser la limite de 60 téléchargements/heure de l’API GitHub anonyme.
GITHUB_TOKEN=
